# Public values are embedded into browser bundles at build time. Set them in
# both the build and runtime environments. They are identifiers, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime-only secret. Never prefix this with NEXT_PUBLIC, pass it as a Docker
# build argument, or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# CLI/import values. They are not needed by the web server.
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_POOLER_HOST=

APP_TIMEZONE=Asia/Kolkata
PATIENT_DOCUMENT_MAX_BYTES=1048576
EXPORT_RETENTION_DAYS=0

# Set to the immutable release/commit identifier shown by the health endpoint.
DEPLOYMENT_VERSION=
NEXT_TELEMETRY_DISABLED=1

# Required only when self-hosting more than one app replica. Generate once with
# `openssl rand -base64 32` and give the same value to every replica.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Server-only Geoapify Address Autocomplete API key.
AUTO_COMPLETE_API=

# Meta Lead Ads: server-only AES-256-GCM key, generated once with
# `openssl rand -hex 32`. Back it up securely; existing tokens need this key.
INTEGRATION_ENCRYPTION_KEY=
# Set the supported Graph API version selected in your Meta app, e.g. vNN.0.
META_GRAPH_API_VERSION=
